# Copy to .env (local) and set the same names in Vercel > Project > Settings > Environment Variables. Never commit .env.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
APP_URL=http://localhost:3000            # production: https://your-domain (QStash calls back to this, so it must be public)
AUTH_SECRET=                             # openssl rand -base64 32
AUTH_TRUST_HOST=true                     # needed on Vercel / custom domains
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
ADMIN_EMAILS=you@gmail.com,teammate@gmail.com
TOTP_ENC_KEY=                            # openssl rand -hex 32 (do not change after admins enrol 2FA)
CRON_SECRET=                             # openssl rand -hex 24 (Vercel sends it to cron routes automatically)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
PLATFORM_BANK_DETAILS=                   # account shown to owners when they pay for a plan, e.g. "BOB 1234567 SportsFB"
PLAN_PLUS_NU=500
PLAN_PRO_NU=1500
RESEND_API_KEY=                          # optional: plan-expiry emails
MAIL_FROM=SportsFB <noreply@your-verified-domain>
